.git
.gitignore
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
data/raw_kpis.csv
data/features.csv
data/events.csv
.pytest_cache/
.mypy_cache/
*.egg-info/
.DS_Store
README.md
docker-compose.yml

# Phase 1 tooling noise — none of this belongs in the runtime image
.dvc/cache
.dvc/tmp
mlruns/
mlartifacts/

# Phase 3 — not needed in the API image; Dockerfile only COPYs
# api/, data/, models/ explicitly, but keep these out of the build
# context anyway so `docker build` doesn't even send them to the daemon
prometheus/
grafana/
tests/
results/
EXPERIMENTS.md

# Phase 4 — production inference log + drift reports; neither belongs
# in the image (logs/ is a runtime volume mount, reports are generated)
logs/
monitoring/reports/

# Phase 5 — Airflow has its own image (Dockerfile.airflow); none of this
# belongs in the API image's build context
airflow/
Dockerfile.airflow
docker-compose.airflow.yml

# Phase 6 — Triton has its own container (official prebuilt image, no
# Dockerfile of ours); none of this belongs in the API image either
triton_model_repository/
docker-compose.triton.yml
models/model.onnx
