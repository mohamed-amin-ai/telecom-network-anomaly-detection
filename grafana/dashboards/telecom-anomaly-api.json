{
  "title": "Telecom Anomaly Detection API",
  "uid": "telecom-anomaly-api",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["telecom-anomaly", "mlops"],
  "panels": [
    {
      "id": 1,
      "title": "Cells Tracked",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "max(cells_tracked)", "legendFormat": "cells", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Model Threshold",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "max(model_threshold_info)", "legendFormat": "threshold", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "purple", "value": null }] },
          "decimals": 3
        },
        "overrides": []
      },
      "description": "A step change here marks a model redeploy with a new tuned threshold."
    },
    {
      "id": 3,
      "title": "Cold-Start (425) Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(cold_start_responses_total[5m]))", "legendFormat": "cold starts/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "reqps",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "description": "Sustained high values suggest many new/unseen cell_ids, or callers not backfilling history before predicting."
    },
    {
      "id": 4,
      "title": "Total HTTP Requests",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(http_requests_total)", "legendFormat": "requests", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Request Rate by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler, status)",
          "legendFormat": "{{handler}} [{{status}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "p95 Latency by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "{{handler}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "description": "Watch /predict specifically — the live feature-computation path (engineer_features on buffered history) is heavier than the precomputed-features path."
    },
    {
      "id": 7,
      "title": "Predictions by Severity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(anomaly_predictions_total[1m])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warning" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "normal" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    },
    {
      "id": 8,
      "title": "Feature Source (precomputed vs live)",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(feature_source_total) by (source)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "description": "A high 'live' share means most callers are sending raw KPIs and relying on the API's rolling history rather than pre-computing features themselves."
    },
    {
      "id": 9,
      "title": "Anomaly Score Distribution",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(anomaly_score_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": { "calculate": false, "color": { "mode": "scheme", "scheme": "Turbo" } },
      "description": "Shows how model output probabilities are actually distributed in production — a healthy model should show most mass near 0, with a thin tail near 1 (the rare real anomalies)."
    },
    {
      "id": 12,
      "title": "Live: right now (last hour)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "panels": []
    },
    {
      "id": 10,
      "title": "Firing Alerts",
      "type": "table",
      "description": "Alerts currently firing, from the Prometheus rules in prometheus/alert_rules.yml. Empty means nothing is firing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 29 },
      "targets": [
        { "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true, "refId": "A" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 11,
      "title": "Cells With Anomalies (last hour)",
      "type": "table",
      "description": "Cells flagged in the last hour, with how often each was flagged in the last 7 and 15 days (red from 20, yellow from 5), so a repeat offender stands out from a one-off. Counts of flagged 15-minute readings, not separate incidents, and approximate at window edges. Prometheus keeps about 15 days. Empty means no cell was flagged in the last hour. Source: anomaly_detections_total (warning and critical only; cell ids beyond the first 1000 are grouped as other).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "targets": [
        { "expr": "sort_desc(sum by (cell_id) (increase(anomaly_detections_total[1h])) > 0)", "format": "table", "instant": true, "refId": "A" },
        { "expr": "sum by (cell_id) (increase(anomaly_detections_total{severity=\"critical\"}[1h])) and on (cell_id) (sum by (cell_id) (increase(anomaly_detections_total[1h])) > 0)", "format": "table", "instant": true, "refId": "B" },
        { "expr": "sum by (cell_id) (increase(anomaly_detections_total[7d])) and on (cell_id) (sum by (cell_id) (increase(anomaly_detections_total[1h])) > 0)", "format": "table", "instant": true, "refId": "C" },
        { "expr": "sum by (cell_id) (increase(anomaly_detections_total[15d])) and on (cell_id) (sum by (cell_id) (increase(anomaly_detections_total[1h])) > 0)", "format": "table", "instant": true, "refId": "D" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "cell_id", "mode": "outer" } },
        { "id": "organize", "options": { "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time": true }, "renameByName": { "cell_id": "Cell", "Value #A": "Flagged (last hour)", "Value #B": "of which critical (1h)", "Value #C": "Flagged (7 days)", "Value #D": "Flagged (15 days)" }, "indexByName": { "cell_id": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4 } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "Flagged \\((7|15) days\\)" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "color", "value": { "mode": "thresholds" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 } ] } },
            { "id": "decimals", "value": 0 }
          ] },
          { "matcher": { "id": "byRegexp", "options": "Flagged \\(last hour\\)|of which critical \\(1h\\)" }, "properties": [ { "id": "decimals", "value": 0 } ] }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 13,
      "title": "History: use the time picker (Prometheus keeps about 15 days)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "panels": []
    },
    {
      "id": 14,
      "title": "Most-Flagged Cells (selected time range)",
      "type": "table",
      "description": "Cells ranked by flagged readings (warning and critical) over the time range chosen in the picker at the top right. Use it to spot cells that keep having problems: set 7 days or 15 days (Prometheus keeps about 15). Counts, not rates: a cell that reports more readings can rank higher.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 44 },
      "targets": [
        { "expr": "sort_desc(sum by (cell_id, severity) (increase(anomaly_detections_total[$__range])) > 0)", "format": "table", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "cell_id": "Cell", "severity": "Severity", "Value": "Flagged readings (range)" } } }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 15,
      "title": "Flagged Readings (trailing hour), Top 10 Cells",
      "type": "timeseries",
      "description": "How many readings of each of the 10 most-flagged cells were flagged in the hour up to each point in time, over the selected time range. A line that stays high means a persistent problem; a short rise means a burst.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 44 },
      "targets": [
        { "expr": "topk(10, sum by (cell_id) (increase(anomaly_detections_total[1h])))", "legendFormat": "{{cell_id}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
