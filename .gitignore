# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env

# OS
.DS_Store
Thumbs.db

# Data & model artifacts — tracked by DVC instead of git, see dvc.yaml.
# `dvc repro` regenerates these locally; `dvc push` syncs them to the
# configured remote. Do not hand-commit these to git.
data/raw_kpis.csv
data/features.csv
models/model.json
models/scaler.pkl
models/metadata.json
models/feature_importance.csv

# MLflow local tracking store (only relevant if MLFLOW_TRACKING_URI is
# unset and it falls back to a local ./mlruns dir; irrelevant once you
# point MLFLOW_TRACKING_URI at a real tracking server)
mlruns/
mlartifacts/

# Phase 4 — production inference log (grows unbounded; not source data,
# it's runtime output) and generated drift reports
logs/
monitoring/reports/

# Phase 5 — Airflow runtime state; airflow/dags/ IS tracked, this isn't
airflow/logs/
*.airflow.db

# Phase 6 — generated ONNX artifact (regenerate via models/convert_to_onnx.py,
# same reasoning as model.json above); config.pbtxt IS tracked, the model
# binary in the Triton repo layout isn't
models/model.onnx
triton_model_repository/*/1/*.onnx

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Misc
.pytest_cache/
.mypy_cache/
*.egg-info/
